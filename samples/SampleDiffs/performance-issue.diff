diff --git a/src/InvoiceReportBuilder.cs b/src/InvoiceReportBuilder.cs
index 2b3c4d5..6e7f8a9 100644
--- a/src/InvoiceReportBuilder.cs
+++ b/src/InvoiceReportBuilder.cs
@@ -8,4 +8,18 @@ public class InvoiceReportBuilder
     {
         _dbContext = dbContext;
     }
+
+    public List<InvoiceSummary> BuildSummaries(IEnumerable<int> customerIds)
+    {
+        var summaries = new List<InvoiceSummary>();
+
+        foreach (var customerId in customerIds)
+        {
+            // N+1 query: fetches invoices one customer at a time inside the loop
+            var invoices = _dbContext.Invoices
+                .Where(i => i.CustomerId == customerId)
+                .ToList();
+
+            summaries.Add(new InvoiceSummary(customerId, invoices.Sum(i => i.Total)));
+        }
+
+        return summaries;
+    }
 }
